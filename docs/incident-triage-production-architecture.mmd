flowchart TB
    subgraph SOURCES["1 · Runtime and detection"]
        direction LR
        APPS["Application services"]
        SIGNALS["Metrics and structured logs"]
        PROM["Prometheus"]
        ALERT["Alertmanager"]
        APPS --> SIGNALS --> PROM --> ALERT
    end

    subgraph INGRESS["2 · Ingress and durable execution"]
        direction LR
        API["FastAPI ingress<br/>webhook · approval · audit"]
        IDEM[("Idempotency store<br/>alert fingerprint → run_id")]
        QUEUE[("Durable work queue")]
        LEDGER[("Run ledger and<br/>graph checkpoints")]
        WORKER["Triage worker"]
        API -->|"deduplicate"| IDEM
        API -->|"202 + run_id"| QUEUE
        API <-->|"run state"| LEDGER
        QUEUE --> WORKER
        WORKER <-->|"resume / checkpoint"| LEDGER
    end

    subgraph REASONING["3 · Bounded agentic control plane"]
        direction LR
        GRAPH["Single LangGraph supervisor<br/>ReAct loop · hard cap 15"]
        MODEL["LLM provider<br/>structured decisions"]
        GATE{"Confidence and<br/>policy gate"}
        PAUSE["HITL interrupt<br/>before write"]
        HUMAN["On-call engineer"]
        GRAPH <-->|"prompt / decision"| MODEL
        GRAPH --> GATE
        GATE -->|"eligible"| PAUSE
        GATE -->|"uncertain / low confidence / cap hit"| HUMAN
        PAUSE <-->|"approve / reject"| HUMAN
    end

    subgraph TOOLS["4 · MCP capability boundary"]
        direction LR
        OBS["Observability MCP<br/>search_logs<br/>get_error_rate<br/>get_recent_deploys<br/>get_metric"]
        ITSM["ITSM MCP<br/>ticket and CI reads<br/>dependency traversal<br/>incident and runbook search<br/>gated ticket writes"]
    end

    subgraph DATA["5 · Systems of record and retrieval"]
        direction LR
        PG[("Postgres<br/>full-text logs · deploys · metrics")]
        VECTOR[("pgvector<br/>past incidents · runbooks")]
        GLPI["GLPI<br/>tickets · CMDB graph"]
        MYSQL[("MySQL")]
        GLPI --> MYSQL
    end

    subgraph ASSURANCE["6 · Observability and release assurance"]
        direction LR
        OTEL["OpenTelemetry<br/>run · model · tool · gate spans"]
        PHX[("Phoenix trace store")]
        AUDIT["GET /runs/{id}<br/>decision-trail reconstruction"]
        EVAL["Evaluation suite<br/>root cause · causal validity<br/>false alarms · efficiency"]
        CHAOS["Chaos suite<br/>six controlled scenarios"]
        CI["CI release gates"]
        OTEL --> PHX --> AUDIT
        EVAL --> CI
        CHAOS --> CI
    end

    ALERT -->|"authenticated webhook"| API
    WORKER --> GRAPH
    GRAPH -->|"typed read calls"| OBS
    GRAPH -->|"typed read calls"| ITSM
    PAUSE -->|"validated write capability"| ITSM
    OBS -->|"exact and time-bounded"| PG
    ITSM -->|"semantic retrieval"| VECTOR
    ITSM -->|"tickets and graph"| GLPI
    GRAPH -. "spans" .-> OTEL
    OBS -. "spans" .-> OTEL
    ITSM -. "spans" .-> OTEL
    GATE -. "spans" .-> OTEL
    AUDIT --> LEDGER
    EVAL -. "tests" .-> GRAPH
    CHAOS -. "faults" .-> APPS

    classDef source fill:#E8F0FE,stroke:#3B63B8,color:#172033,stroke-width:1.5px;
    classDef control fill:#FFF4DE,stroke:#B87918,color:#3D2A0A,stroke-width:1.5px;
    classDef tool fill:#E9F7EF,stroke:#2E7D52,color:#153923,stroke-width:1.5px;
    classDef data fill:#F2ECFA,stroke:#7154A3,color:#2C2140,stroke-width:1.5px;
    classDef assurance fill:#FDECEF,stroke:#A74A5D,color:#451E27,stroke-width:1.5px;

    class APPS,SIGNALS,PROM,ALERT,API,IDEM,QUEUE,LEDGER,WORKER source;
    class GRAPH,MODEL,GATE,PAUSE,HUMAN control;
    class OBS,ITSM tool;
    class PG,VECTOR,GLPI,MYSQL data;
    class OTEL,PHX,AUDIT,EVAL,CHAOS,CI assurance;
