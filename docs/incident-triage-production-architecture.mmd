%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#E8F0FE",
    "primaryTextColor": "#172033",
    "primaryBorderColor": "#3B63B8",
    "lineColor": "#526178",
    "secondaryColor": "#E9F7EF",
    "tertiaryColor": "#FFF4DE",
    "clusterBkg": "#F7F9FC",
    "clusterBorder": "#AEB9CC",
    "edgeLabelBackground": "#FFFFFF"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 42,
    "rankSpacing": 58,
